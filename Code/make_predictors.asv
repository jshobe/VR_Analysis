function out = make_predictors(parityOrVR, varargin)
% MAKE_PREDICTORS
% Builds GLM predictor tables with 5 columns: Pos, Context, Chair, Drum, Star.
% Supports generating four canonical files:
%   - Predictors_Odd_Block13.xlsx
%   - Predictors_Odd_Block2.xlsx
%   - Predictors_Even_Block13.xlsx
%   - Predictors_Even_Block2.xlsx
%
% Usage:
%   % Zero-argument call now works: generates four files in current folder
%   make_predictors
%
%   % Or explicitly:
%   make_predictors('templates')                          % current folder
%   make_predictors('templates','OutDir','C:\path\out')   % custom folder
%
%   % Single-file mode for a specific VR animal & block:
%   T = make_predictors('VR29','Block',3,'SavePath','Predictors_VR29_B3.xlsx');

% ---------------- Parse inputs ----------------
p = inputParser;
addParameter(p, 'Block', 3, @(x)isnumeric(x)&&isscalar(x)&&ismember(x,[1 2 3]));
addParameter(p, 'nBins', 133, @(x)isnumeric(x)&&isscalar(x)&&x>=10);
addParameter(p, 'StartFrac', 0.25, @(x)isnumeric(x)&&isscalar(x)&&x>=0&&x<1);
addParameter(p, 'SavePath', 'Predictors.xlsx', @(s)ischar(s)||isstring(s));
addParameter(p, 'WriteExcel', true, @islogical);
addParameter(p, 'OutDir', pwd, @(s)ischar(s)||isstring(s));
parse(p, varargin{:});
opt = p.Results;

% Default to template mode when called with no args
if nargin < 1 || isempty(parityOrVR)
    parityOrVR = 'templates';
end
templatesMode = ischar(parityOrVR) && strcmpi(strtrim(parityOrVR), 'templates');

% ---------------- Corridor setup ----------------
nBins   = opt.nBins;
pos     = (1:nBins) / nBins;                    % normalized position [0..1]
startIx = max(1, round(opt.StartFrac * nBins)); % visibility starts at ~33 for 133 bins
midIx   = min(nBins, 67);                       % midpoint bin
endIx   = min(nBins, 133);                      % end bin

if templatesMode
    % ========== TEMPLATE MODE: write four files ==========
    out = struct();
    % Odd parity templates
    out.Odd_Block13 = build_block_table(false, '13', pos, startIx, midIx, endIx, nBins);
    out.Odd_Block2  = build_block_table(false, '2',  pos, startIx, midIx, endIx, nBins);
    % Even parity templates
    out.Even_Block13 = build_block_table(true, '13', pos, startIx, midIx, endIx, nBins);
    out.Even_Block2  = build_block_table(true, '2',  pos, startIx, midIx, endIx, nBins);
    % Save all four
    try
        writetable(out.Odd_Block13,  fullfile(opt.OutDir, 'Predictors_Odd_Block13.xlsx'));
        writetable(out.Odd_Block2,   fullfile(opt.OutDir, 'Predictors_Odd_Block2.xlsx'));
        writetable(out.Even_Block13, fullfile(opt.OutDir, 'Predictors_Even_Block13.xlsx'));
        writetable(out.Even_Block2,  fullfile(opt.OutDir, 'Predictors_Even_Block2.xlsx'));
        fprintf('[make_predictors] Wrote 4 template files to %s\n', char(opt.OutDir));
    catch ME
        warning('[make_predictors] Failed to write template files: %s', ME.message);
    end
    return;
end

% ========== SINGLE-FILE MODE ==========
animalName = parse_vr_name(parityOrVR);
vrNum = parse_vr_number(animalName);
isEven = mod(vrNum, 2) == 0;

blockKind = tern(opt.Block == 2, '2', '13'); % treat 1 and 3 the same
T = build_block_table(isEven, blockKind, pos, startIx, midIx, endIx, nBins);
out = T;

if opt.WriteExcel
    try
        writetable(T, opt.SavePath);
        fprintf('[make_predictors] Wrote %s (rows=%d)\n', opt.SavePath, height(T));
    % catch ME
    %     warning('[make_predictors] Failed to write Excel: %s', ME.message);
    end
end

end

% ===== Core builder: one block table for given parity/kind =====
function T = build_block_table(isEven, blockKind, pos, startIx, midIx, endIx, nBins)
% isEven   : true for even VR folders, false for odd
% blockKind: '13' (Blocks 1 & 3) or '2' (Block 2)

% Trial-type specs by parity (per your spec):
% Odd:
%   Block13: TT1=C_S(A), TT2=S_D(A), TT3=C_S(B), TT4=S_D(B)
%   Block2 : TT1=C_S(A), TT2=S_D(A), TT5=S_C(A), TT6=D_S(A)
% Even:
%   Block13: TT1=S_C(A), TT2=D_S(A), TT3=S_C(B), TT4=D_S(B)
%   Block2 : TT1=S_C(A), TT2=D_S(A), TT5=C_S(A), TT6=S_D(A)

if ~isEven
    TT_A      = {'C_S','S_D'};    % TT1, TT2 in A
    TT_B      = {'C_S','S_D'};    % TT3, TT4 in B
    TT_SWAP_A = {'S_C','D_S'};    % TT5, TT6 in A
else
    TT_A      = {'S_C','D_S'};
    TT_B      = {'S_C','D_S'};
    TT_SWAP_A = {'C_S','S_D'};
end

switch blockKind
    case '13'
        segments = [ ...
            struct('spec', TT_A{1},     'ctx', 0);  % TT1, A
            struct('spec', TT_A{2},     'ctx', 0);  % TT2, A
            struct('spec', TT_B{1},     'ctx', 1);  % TT3, B
            struct('spec', TT_B{2},     'ctx', 1)   % TT4, B
        ];
    case '2'
        segments = [ ...
            struct('spec', TT_A{1},        'ctx', 0);  % TT1, A
            struct('spec', TT_A{2},        'ctx', 0);  % TT2, A
            struct('spec', TT_SWAP_A{1},   'ctx', 0);  % TT5, A (swap)
            struct('spec', TT_SWAP_A{2},   'ctx', 0)   % TT6, A (swap)
        ];
    otherwise
        error('Invalid blockKind "%s". Use "13" or "2".', blockKind);
end

% Build predictors per segment
Tblocks = cell(numel(segments), 1);
for s = 1:numel(segments)
    Pos     = pos(:);
    Context = segments(s).ctx * ones(nBins,1); % 0=A, 1=B
    Chair   = zeros(nBins,1);
    Drum    = zeros(nBins,1);
    Star    = zeros(nBins,1);

    [midObj, endObj] = parse_spec(segments(s).spec);

    % Ramp from StartFrac to final position; saturate at 1 afterwards
    if ~isempty(midObj)
        switch midObj
            case 'C', Chair = max(Chair, ramp_vec(nBins, startIx, midIx));
            case 'D', Drum  = max(Drum,  ramp_vec(nBins, startIx, midIx));
            case 'S', Star  = max(Star,  ramp_vec(nBins, startIx, midIx));
        end
    end
    if ~isempty(endObj)
        switch endObj
            case 'C', Chair = max(Chair, ramp_vec(nBins, startIx, endIx));
            case 'D', Drum  = max(Drum,  ramp_vec(nBins, startIx, endIx));
            case 'S', Star  = max(Star,  ramp_vec(nBins, startIx, endIx));
        end
    end

    Chair = min(max(Chair,0),1);
    Drum  = min(max(Drum,0),1);
    Star  = min(max(Star,0),1);

    Tblocks{s} = table(Pos, Context, Chair, Drum, Star);
end

T = vertcat(Tblocks{:});
end

% ===== Helpers =====
function name = parse_vr_name(input)
if ischar(input) || isstring(input)
    s = char(input);
else
    error('make_predictors:InvalidName','Input must be a string path or VR name.');
end
[~, base] = fileparts(s);
if startsWith(base, 'VR', 'IgnoreCase', true)
    name = base;
else
    name = s;
end
end

function n = parse_vr_number(vrname)
tok = regexp(vrname, 'VR(\d+)', 'tokens', 'once');
if isempty(tok), error('make_predictors:VRParse','Cannot parse VR number from "%s"', vrname); end
n = str2double(tok{1});
end

function [midObj, endObj] = parse_spec(spec)
parts = strsplit(strrep(spec,' ','') ,'_');
if numel(parts) ~= 2
    error('make_predictors:SpecParse','Invalid spec "%s". Expected like C_S or S_D.', spec);
end
midObj = upper(parts{1});
endObj = upper(parts{2});
end

function v = ramp_vec(nBins, startIx, endIx)
% Saturating ramp:
% - 0 before startIx
% - 0.25 at startIx
% - linear 0.25 -> 1.0 to endIx
% - 1.0 after endIx
v = zeros(nBins,1);
startIx = min(max(round(startIx),1), nBins);
endIx   = min(max(round(endIx),  1), nBins);
if endIx < startIx
    v(startIx) = 0.25;
    return;
end
n = endIx - startIx;
if n == 0
    v(startIx:end) = 1.0;
    v(startIx) = max(v(startIx), 0.25);
    return;
end
ramp = linspace(0.25, 1.0, n+1);
v(startIx:endIx) = max(v(startIx:endIx), ramp(:));
if endIx < nBins
    v(endIx+1:end) = 1.0;
end
end

function s = tern(c, a, b)
if c, s = a; else, s = b; end
end